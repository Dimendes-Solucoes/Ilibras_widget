{
  "name": "ilibras-widget",
  "version": "1.5.1",
  "description": "Widget de acessibilidade em Libras: formulário embarcável que leva a pessoa surda ao atendimento com intérprete, ao vivo ou agendado",
  "type": "module",
  "main": "./dist/ilibras-widget.cjs",
  "module": "./dist/ilibras-widget.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/ilibras-widget.mjs",
      "require": "./dist/ilibras-widget.cjs",
      "default": "./dist/ilibras-widget.mjs"
    },
    "./dist/ilibras-widget.js": "./dist/ilibras-widget.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/ilibras-widget.js",
  "jsdelivr": "./dist/ilibras-widget.js",
  "sideEffects": false,
  "files": [
    "dist/",
    "index.d.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "gerar-assets": "node scripts/gerar-assets.mjs",
    "build": "npm run gerar-assets && node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "test": "node --test tests/**/*.test.mjs"
  },
  "keywords": [
    "libras",
    "acessibilidade",
    "accessibility",
    "surdos",
    "sign-language",
    "lsb",
    "widget",
    "a11y",
    "ilibras"
  ],
  "author": "Dimendes Soluções",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dimendes-Solucoes/Ilibras_widget.git"
  },
  "bugs": {
    "url": "https://github.com/Dimendes-Solucoes/Ilibras_widget/issues"
  },
  "homepage": "https://github.com/Dimendes-Solucoes/Ilibras_widget#readme",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
